<?xml version="1.0" encoding="utf-8"?>
<!-- 120deg CSS gradient approximated: Android angles are multiples of 45, so 315 (Android's clockwise-from-top-left) is the nearest (top-left to bottom-right). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient android:angle="315" android:startColor="#fff0d9" android:centerColor="#fbd6f7" android:endColor="#cdf9fb" />
</shape>
